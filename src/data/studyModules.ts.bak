    codeSnippet: {
      language: "python",
      code: `import subprocess
import logging

logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")

def summarize_eapol(pcap_file: str):
    """
    Parses a .cap file for WPA2 4-way handshakes.
    Summarizes source/destination MAC addresses associated with EAPOL frames.
    No cracking performed. Safe lab operations.
    """
    logging.info(f"Analyzing {pcap_file} for EAPOL frames...")
    
    tshark_cmd = [
        "tshark", "-r", pcap_file, 
        "-Y", "eapol", 
        "-T", "fields", 
        "-e", "wlan.sa", 
        "-e", "wlan.da"
    ]
    
    try:
        result = subprocess.run(tshark_cmd, shell=False, capture_output=True, text=True, check=True)
        lines = result.stdout.strip().split('\\n')
        
        eapol_count = 0
        pairs = set()
        
        for line in lines:
            if line:
                sa, da = line.split('\\t')
                pairs.add((sa, da))
                eapol_count += 1
                
        logging.info(f"Total EAPOL frames identified: {eapol_count}")
        logging.info("Unique SA/DA pairs involved in handshake:")
        for sa, da in pairs:
            logging.info(f"  Src: {sa} -> Dst: {da}")

    except subprocess.CalledProcessError as e:
        logging.error(f"Failed to parse pcap: {e}")
    except FileNotFoundError:
        logging.error("tshark binary not found. Please install wireshark-cli.")
`
    },
