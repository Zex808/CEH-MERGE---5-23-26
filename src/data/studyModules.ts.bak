    codeSnippet: {
      language: "python",
      code: `import subprocess
import logging
from typing import List, Optional

logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")

def run_hashcat(hash_file: str, wordlist: str, hash_type: int) -> Optional[str]:
    """
    Executes Hashcat against a target hash file.
    Always uses shell=False to prevent command injection vulnerabilities.
    """
    command: List[str] = [
        "hashcat",
        "-a", "0",                  # Dictionary attack
        "-m", str(hash_type),       # Hash format (e.g., 1000 for NTLM)
        hash_file,
        wordlist,
        "--potfile-disable",        # For repeated lab testing
        "--quiet"
    ]
    
    try:
        logging.info(f"Starting offline cracking on {hash_file}")
        result = subprocess.run(command, shell=False, capture_output=True, text=True, check=False)
        
        if result.returncode in [0, 1]:
            return result.stdout
        else:
            logging.error(f"Hashcat execution failed: {result.stderr}")
            return None
    except FileNotFoundError:
        logging.error("Hashcat binary not found. Ensure it is installed and in PATH.")
        return None
`
