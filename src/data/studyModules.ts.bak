      language: "python",
      code: `import subprocess
import logging
from typing import List

logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")

# Explicit allowlist of benign binaries
ALLOWED_BINARIES = ["notepad.exe", "calc.exe", "ping.exe"]

def manage_benign_task(task_name: str, binary: str, action: str = "create") -> bool:
    """
    Safely creates, queries, or deletes a scheduled task using an allowlist.
    """
    if binary not in ALLOWED_BINARIES:
        logging.error(f"Binary {binary} not allowed. Lab safety constraint.")
        return False

    cmd: List[str] = []
    if action == "create":
        cmd = ["schtasks", "/create", "/tn", task_name, "/tr", binary, "/sc", "daily", "/st", "12:00"]
    elif action == "delete":
        cmd = ["schtasks", "/delete", "/tn", task_name, "/f"]
    elif action == "query":
        cmd = ["schtasks", "/query", "/tn", task_name, "/fo", "list"]
    else:
        return False

    logging.info(f"Dry Run (Command to run): {' '.join(cmd)}")
    
    # Active testing disabled for strictly benign static lab module
    # result = subprocess.run(cmd, shell=False, capture_output=True, text=True)
    # logging.info(result.stdout)
    return True
`
