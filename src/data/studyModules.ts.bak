    codeSnippet: {
      language: "python",
      code: `import subprocess
import logging

logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")

def run_isolated_scaffold(scaffold_script: str, dummy_image: str = "nginx:alpine"):
    """
    Spawns a dummy target, runs the exploit scaffold in a tightly constrained 
    sandbox, captures output, and ensures cleanup.
    """
    logging.info("Starting dummy target container...")
    try:
        subprocess.run(["docker", "run", "-d", "--name", "dummy_target", dummy_image], check=True, shell=False)

        logging.info("Executing scaffold against dummy target...")
        scaffold_cmd = [
            "docker", "run", "--rm", 
            "--network", "container:dummy_target",
            "--cap-drop=ALL",          # Drop all capabilities
            "--read-only",             # Read-only filesystem
            "--memory=128m",           # Limit memory
            "-v", f"{scaffold_script}:/app/scaffold.py:ro",
            "python:3.9-slim", 
            "python", "/app/scaffold.py", "http://127.0.0.1:80"
        ]
        
        result = subprocess.run(scaffold_cmd, capture_output=True, text=True, timeout=10, shell=False)
        logging.info(f"Scaffold Output:\\n{result.stdout}")
        
    except subprocess.TimeoutExpired:
        logging.error("Scaffold execution timed out.")
    except Exception as e:
        logging.error(f"Error during sandbox execution: {e}")
    finally:
        logging.info("Cleaning up dummy target...")
        subprocess.run(["docker", "rm", "-f", "dummy_target"], shell=False, check=False, capture_output=True)
`
